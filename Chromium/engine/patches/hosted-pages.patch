--- a/ui/views/controls/webview/webview.cc
+++ b/ui/views/controls/webview/webview.cc
@@ -27,6 +27,7 @@
 #include "ui/events/event.h"
 #include "ui/views/accessibility/tree/widget_ax_manager.h"
 #include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/controls/webview/openarc_hosted_page.h"
 #include "ui/views/controls/webview/web_contents_set_background_color.h"
 #include "ui/views/focus/focus_manager.h"
 #include "ui/views/views_delegate.h"
@@ -560,6 +561,11 @@ void WebView::AttachWebContentsNativeView() {
   if (!GetWidget() || !web_contents()) {
     return;
   }
+  // OpenArc: its pages stay in OpenArc's windows, and its page-host windows attach none.
+  if (web_contents()->GetUserData(OpenArcHostedPageKey()) ||
+      GetWidget()->GetNativeWindowProperty(kOpenArcPageHostWindow)) {
+    return;
+  }
 
   gfx::NativeView view_to_attach = web_contents()->GetNativeView();
   OnBoundsChanged(bounds());
