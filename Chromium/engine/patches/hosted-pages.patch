diff --git a/ui/views/controls/webview/openarc_hosted_page.h b/ui/views/controls/webview/openarc_hosted_page.h
new file mode 100644
index 0000000000..b070fb1d0d
--- /dev/null
+++ b/ui/views/controls/webview/openarc_hosted_page.h
@@ -0,0 +1,22 @@
+// OpenArc (Chromium/engine in the OpenArc repository), based on Cra's hosted pages (MIT License).
+#ifndef UI_VIEWS_CONTROLS_WEBVIEW_OPENARC_HOSTED_PAGE_H_
+#define UI_VIEWS_CONTROLS_WEBVIEW_OPENARC_HOSTED_PAGE_H_
+
+namespace views {
+
+// A page OpenArc shows in its own windows carries this user data key. A WebView never attaches such a page's
+// native view, so Chrome's (never shown) window doesn't take it from OpenArc's, whichever tab Chrome has
+// active.
+inline const void* OpenArcHostedPageKey() {
+  static const int key = 0;
+  return &key;
+}
+
+// The (never shown) window that holds a profile's pages carries this native window property: its WebViews
+// attach no page at all, so a page that arrives in it (a link opened in a new tab, a pop-up) is never drawn
+// there before OpenArc takes it.
+inline constexpr char kOpenArcPageHostWindow[] = "openarc-page-host";
+
+}  // namespace views
+
+#endif  // UI_VIEWS_CONTROLS_WEBVIEW_OPENARC_HOSTED_PAGE_H_
diff --git a/ui/views/controls/webview/webview.cc b/ui/views/controls/webview/webview.cc
