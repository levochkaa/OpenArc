{
  "manifest_version": 3,
  "name": "OpenArc Smoke Test",
  "version": "1.0",
  "description": "Reports chrome.tabs.query results to the smoke test's pages.",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "OpenArc Smoke Test", "default_popup": "popup.html" },
  "content_scripts": [{ "matches": ["http://127.0.0.1/*"], "js": ["content.js"], "run_at": "document_idle" }]
}
