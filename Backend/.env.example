DATABASE_URL=postgres://openarc:openarc@localhost:5432/openarc
PORT=8080
HOST=0.0.0.0
APPLE_CLIENT_ID=com.levochkaa.OpenArc
# Optional explicit allowlist, replacing APPLE_CLIENT_ID when configured.
# Use the exact Apple client IDs provisioned for your desktop and mobile apps.
# APPLE_CLIENT_IDS=com.levochkaa.OpenArc,com.example.provisioned-mobile-client
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=openarc-sync
JWT_AUDIENCE=openarc-clients
CORS_ORIGIN=
# Sign-in methods; each is offered only when configured. Web sign-in needs
# OPENARC_PUBLIC_BASE_URL, the base of the providers' redirect URIs.
# OPENARC_PUBLIC_BASE_URL=https://api.example.com
# OPENARC_APPLE_SERVICES_ID=com.example.signin
# OPENARC_GOOGLE_CLIENT_ID=
# OPENARC_GOOGLE_CLIENT_SECRET=
# OPENARC_GITHUB_CLIENT_ID=
# OPENARC_GITHUB_CLIENT_SECRET=
# Sign-in codes go out over any provider's SMTP.
# OPENARC_SMTP_HOST=smtp.example.com
# OPENARC_SMTP_PORT=587
# OPENARC_SMTP_SECURITY=starttls
# OPENARC_SMTP_USERNAME=
# OPENARC_SMTP_PASSWORD=
# OPENARC_EMAIL_FROM=OpenArc <login@example.com>
