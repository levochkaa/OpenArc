+static Bindings::NotificationPermission notification_permission_from(PermissionsAPI::PermissionState state)
+{
+    switch (state) {
+    case PermissionsAPI::PermissionState::Granted:
+        return Bindings::NotificationPermission::Granted;
+    case PermissionsAPI::PermissionState::Denied:
+        return Bindings::NotificationPermission::Denied;
+    default:
+        return Bindings::NotificationPermission::Default;
+    }
+}
+
+// https://notifications.spec.whatwg.org/#get-the-notifications-permission-state
+Bindings::NotificationPermission Notification::permission()
+{
+    PermissionsAPI::PermissionDescriptor descriptor { "notifications"_utf16 };
+    return notification_permission_from(PermissionsAPI::permission_state(descriptor));
+}
+
+// https://notifications.spec.whatwg.org/#dom-notification-requestpermission
+GC::Ref<WebIDL::Promise> Notification::request_permission(JS::VM& vm, GC::Ptr<WebIDL::CallbackType> deprecated_callback)
+{
+    auto& realm = *vm.current_realm();
+
+    // 1. Let global be the current global object.
+    auto& global = HTML::current_global_object();
+
+    // 2. Let promise be a new promise in this’s relevant Realm.
+    auto promise = WebIDL::create_promise(realm);
+
+    // 4. Queue a global task on the DOM manipulation task source given global to run these steps:
+    //    1. If deprecatedCallback is given, then invoke deprecatedCallback with « permissionState » and "report".
+    //    2. Resolve promise with permissionState.
+    auto finish = GC::create_function(GC::Heap::the(), [global = GC::Ref { global }, promise, deprecated_callback](Bindings::NotificationPermission permission_state) {
+        HTML::queue_global_task(HTML::Task::Source::DOMManipulation, global, GC::create_function(GC::Heap::the(), [promise, deprecated_callback, permission_state] {
+            auto& realm = WebIDL::promise_realm(promise);
+            HTML::TemporaryExecutionContext execution_context { realm, HTML::TemporaryExecutionContext::CallbacksEnabled::Yes };
+            auto value = JS::PrimitiveString::create(realm.vm(), Bindings::idl_enum_to_string(permission_state));
+            if (deprecated_callback)
+                (void)WebIDL::invoke_callback(*deprecated_callback, {}, { { value } });
+            WebIDL::resolve_promise(promise, value);
+        }));
+    });
+
+    // 3. Run these steps in parallel:
+    //    1. Let permissionState be the result of requesting permission to use "notifications".
+    PermissionsAPI::PermissionDescriptor descriptor { "notifications"_utf16 };
+    auto state = PermissionsAPI::permission_state(descriptor);
+    auto* window = HTML::window_from_global_object(global);
+    if (state != PermissionsAPI::PermissionState::Prompt || !window) {
+        finish->function()(notification_permission_from(state));
+        return promise;
+    }
+
+    // AD-HOC: The user answers in the UI process; their answer stays in the permission store, a dismissal does not.
+    auto& settings = HTML::current_settings_object();
+    auto key = PermissionsAPI::permission_key_generation_algorithm(settings.top_level_origin.value(), settings.origin());
+    window->page().request_permission("notifications"_string, GC::create_function(GC::Heap::the(), [finish, descriptor, key](Optional<bool> granted) {
+        if (!granted.has_value()) {
+            finish->function()(Bindings::NotificationPermission::Default);
+            return;
+        }
+        auto state = *granted ? PermissionsAPI::PermissionState::Granted : PermissionsAPI::PermissionState::Denied;
+        PermissionsAPI::PermissionStore::the().set_permission_store_entry(descriptor, key, state);
+        finish->function()(notification_permission_from(state));
+    }));
+    return promise;
+}
