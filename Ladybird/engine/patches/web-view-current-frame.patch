+- (CGImageRef)copyCurrentFrame
+{
+    auto paintable = m_web_view_bridge->paintable();
+    if (!paintable.has_value() || !paintable->shared_image_buffer)
+        return nullptr;
+    auto [shared_image_buffer, bitmap_size] = *paintable;
+    if (bitmap_size.is_empty())
+        return nullptr;
+
+    // The backing store is reused for later frames, so the picture keeps a copy of its pixels: from the CPU bitmap,
+    // or from the IOSurface WebContent painted on the GPU.
+    CFDataRef data = nullptr;
+    size_t pitch = 0;
+    auto width = static_cast<size_t>(bitmap_size.width());
+    auto height = static_cast<size_t>(bitmap_size.height());
+    if (auto bitmap = shared_image_buffer->bitmap_if_present(); bitmap && bitmap->format() == Gfx::BitmapFormat::BGRA8888) {
+        width = min(width, static_cast<size_t>(bitmap->width()));
+        height = min(height, static_cast<size_t>(bitmap->height()));
+        pitch = bitmap->pitch();
+        data = CFDataCreate(nullptr, bitmap->scanline_u8(0), pitch * height);
+    } else if (auto* surface = (IOSurfaceRef)shared_image_buffer->iosurface_handle().core_foundation_pointer()) {
+        IOSurfaceLock(surface, kIOSurfaceLockReadOnly, nullptr);
+        width = min(width, IOSurfaceGetWidth(surface));
+        height = min(height, IOSurfaceGetHeight(surface));
+        pitch = IOSurfaceGetBytesPerRow(surface);
+        data = CFDataCreate(nullptr, static_cast<UInt8 const*>(IOSurfaceGetBaseAddress(surface)), pitch * height);
+        IOSurfaceUnlock(surface, kIOSurfaceLockReadOnly, nullptr);
+    }
+    if (!data)
+        return nullptr;
+    auto* provider = CGDataProviderCreateWithCFData(data);
+    static auto* color_space = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
+    auto* image = CGImageCreate(width, height, 8, 32, pitch, color_space,
+        kCGBitmapByteOrder32Little | kCGImageAlphaFirst, provider, nullptr, NO, kCGRenderingIntentDefault);
+    CGDataProviderRelease(provider);
+    CFRelease(data);
+    return image;
+}
