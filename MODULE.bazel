module(
    name = "thebrowser",
    version = "0.1.0",
)

bazel_dep(name = "rules_apple", version = "4.5.3", repo_name = "build_bazel_rules_apple")
bazel_dep(name = "apple_support", version = "2.2.0", repo_name = "build_bazel_apple_support")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_swift", version = "3.6.1", repo_name = "build_bazel_rules_swift")
bazel_dep(name = "rules_swift_package_manager", version = "1.15.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_xcodeproj", version = "4.0.1")

swift_deps = use_extension(
    "@rules_swift_package_manager//:extensions.bzl",
    "swift_deps",
)
swift_deps.configure_package(
    name = "swiftdomainparser",
    publicly_expose_all_targets = True,
)
swift_deps.from_package(
    resolved = "//:Package.resolved",
    swift = "//:Package.swift",
)
use_repo(
    swift_deps,
    "swift_package",
    "swiftpkg_swiftdomainparser",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_archive(
    name = "cef_macosarm64",
    build_file = "//bazel/cef:BUILD.cef.bazel",
    sha256 = "196407015336c8f29c2ee34f1ba819b17fff79a139ae537b1ef7b39ceef84d41",
    strip_prefix = "cef_binary_141.0.5+gfe26daa+chromium-141.0.7390.55_macosarm64",
    urls = [
        "https://cef-builds.spotifycdn.com/cef_binary_141.0.5%2Bgfe26daa%2Bchromium-141.0.7390.55_macosarm64.tar.bz2",
    ],
)

http_file(
    name = "swiftdomainparser_public_suffix_list",
    downloaded_file_path = "public_suffix_list.dat",
    sha256 = "e35d14510330f059390ae5ce7f0eea538629e3041aedad60e9534ab84f204ce4",
    urls = [
        "https://raw.githubusercontent.com/Dashlane/SwiftDomainParser/ac1df3211011ad44c20457412eeb45beb318f847/DomainParser/DomainParser/Resources/public_suffix_list.dat",
    ],
)
